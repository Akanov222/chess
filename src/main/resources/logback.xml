<configuration debug="false">
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />
    <property name="LOG_PATH" value="logs"/>

    <!-- 1. Технический лог (TRACE, DEBUG, INFO, ERROR) -->
    <appender name="TECH_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/chess-tech.logs</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/tech-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>1</maxHistory> <!-- храним 1 день -->
            <totalSizeCap>100MB</totalSizeCap> <!-- общий лимит логов -->
        </rollingPolicy>
        <append>false</append> <!-- true, если не хотите очищать файл при каждом запуске -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{gameId}] %-5level %logger{15} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Лог истории игры (только INFO) -->
    <appender name="GAME_HISTORY" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/game_history.logs</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archived/history-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern>
            <maxFileSize>1MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>10MB</totalSizeCap>
        </rollingPolicy>
        <!-- Фильтр: пропускаем только INFO -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <!-- Для истории игр делаем максимально чистый вывод без лишних дебаг-данных -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%X{gameId}] | %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Настройка для вашего проекта -->
    <logger name="edu.iv.javacourse" level="DEBUG" additivity="false">
        <appender-ref ref="TECH_LOG"/>
        <appender-ref ref="GAME_HISTORY"/>
    </logger>

    <!-- Отключаем мусор от сторонних библиотек в консоли, но ловим ошибки -->
    <root level="ERROR">
        <appender-ref ref="TECH_LOG"/>
    </root>
</configuration>